REDIS_HOST=localhost
REDIS_PORT=6379
NEO4J_URL=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
SCHEDULER_LANE_MAX_PRIORITY=10
# Optional. Neo4j stores scores only above this Influence (default 0.0001, 0 = store all but exact zeros).
# INFLUENCE_PERSIST_FLOOR=0.0001
# Optional. Influence within this of its stored value keeps the stored value (default 0.0005, 0 = off).
# INFLUENCE_DEAD_ZONE=0.0005
# Optional. Read stored scores from the Scorecard database instead of Neo4j properties (default false).
# On needs the five settings below; flipped together with the server's SCORES_IN_POSTGRES.
# SCORES_IN_POSTGRES=false
# SCORECARD_DB_HOST=localhost
# SCORECARD_DB_PORT=5432
# SCORECARD_DB_NAME=scorecard
# SCORECARD_DB_USER=postgres
# SCORECARD_DB_PASSWORD=password
